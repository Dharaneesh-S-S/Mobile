<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_combined_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Half: Music Player Section -->
    <LinearLayout
        android:id="@+id/combined_music_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Album Art / Music Icon -->
        <ImageView
            android:id="@+id/combined_widget_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#0D2422"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_music_note"
            android:contentDescription="Album Art" />

        <!-- Music Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/combined_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Personal Hub Music"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/combined_widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to play"
                android:textColor="#99E8DD"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Playback Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/combined_widget_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_prev" />

            <ImageButton
                android:id="@+id/combined_widget_play_pause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play or Pause"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/combined_widget_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtle Teal Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#2019E6C8" />

    <!-- Bottom Half: Mobile Usage Section -->
    <LinearLayout
        android:id="@+id/combined_usage_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#0D2422"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_widget_usage"
                android:contentDescription="Screen Time" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TODAY'S SCREEN TIME"
                android:textColor="#19E6C8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/combined_widget_screen_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0m"
                android:textColor="#F4FFFD"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/combined_widget_top_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No usage recorded"
                android:textColor="#99E8DD"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#0B201E"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <TextView
                android:id="@+id/combined_widget_usage_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active"
                android:textColor="#19E6C8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
